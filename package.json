{
  "name": "historical-explorer",
  "version": "0.11.1",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "deps:install": "pnpm install --frozen-lockfile",
    "dev": "pnpm catalog:build && next dev",
    "prototype:gallery": "pnpm dev",
    "build": "pnpm catalog:build && next build",
    "test": "pnpm catalog:build && vitest run",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write",
    "prepare": "husky",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:check": "node scripts/check-release.mjs",
    "categories:rebuild": "tsx --env-file-if-exists=.env.local scripts/rebuild-poi-categories.mjs",
    "catalog:build": "tsx scripts/build-public-catalog.ts",
    "test:content-database": "tsx scripts/test-content-database.ts",
    "content:probe": "tsx --env-file-if-exists=.env.local scripts/probe-content-database.ts"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@vercel/functions": "^3.10.3",
    "clsx": "^2.1.1",
    "jsonrepair": "^3.15.0",
    "maplibre-gl": "^5.24.0",
    "motion": "12.40.0",
    "next": "16.4.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "wtf_wikipedia": "^10.4.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.11.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
