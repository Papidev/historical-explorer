    "description": [
      {
        "text": "Fernando Álvarez de Toledo, a Spanish nobleman and military commander, served as plenipotentiary for King Philip II and held high offices across the Spanish Empire, including governorship of Milan and viceroy of Naples.",
        "sourceIds": ["wikipedia"]
      },
      {
        "text": "His most infamous tenure was as Governor‑General of the Spanish Netherlands, where he imposed harsh military measures and fiscal policies that earned him the nicknames \"Duke of Iron\" and \"butcher of Flanders\" among Dutch Protestants.",
        "sourceIds": ["wikipedia"]
      }
    ],
    "curiosities": [
      {
        "text": "Dutch Protestants dubbed him the \"Duke of Iron\" for his uncompromising military discipline.",
        "sourceIds": ["wikipedia"]
      },
      {
        "text": "He was also called the \"butcher of Flanders\" because of the brutal tactics he used during campaigns in the Low Countries.",
        "sourceIds": ["wikipedia"]
      },
      {
        "text": "Álvarez de Toledo distinguished himself at the Battle of Mühlberg in 1547, contributing decisively to the defeat of the Schmalkaldic League.",
        "sourceIds": ["wikipedia"]
      }
    ],
