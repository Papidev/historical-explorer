{
  "introduction": {
    "text": "The Basilica di San Paolo fuori le mura is one of Rome's four major papal basilicas and a key site of Christian pilgrimage, built over the traditional burial place of Saint Paul.",
    "sourceIds": ["wikipedia"]
  },
  "topics": {
    "history": [
      {
        "id": "history1",
        "description": "Constantine the Great founded the first basilica over the burial site of Saint Paul, which was consecrated by Pope Sylvester I in 324.",
