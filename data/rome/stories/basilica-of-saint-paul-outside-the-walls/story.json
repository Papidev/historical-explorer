          "startYear": 324,
          "precision": "exact",
          "granularity": "year"
        }
      },
      {
        "id": "history2",
        "description": "Theodosius I began constructing a larger basilica in 386, which was probably consecrated around 402.",
        "sourceIds": ["wikipedia"],
