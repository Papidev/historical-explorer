          "startYear": 386,
          "precision": "approximate",
          "endYear": 402,
          "granularity": "year"
        }
      },
      {
        "id": "history3",
        "description": "Pope Leo I completed the mosaics of the basilica during his pontificate (440–461).",
        "sourceIds": ["wikipedia"],
        "time": {
          "startYear": 440,
          "precision": "approximate",
          "endYear": 461,
          "granularity": "year"
        }
      },
      {
        "id": "history4",
        "description": "Pope Gregory the Great extensively modified the main altar and presbytery between 590 and 604.",
