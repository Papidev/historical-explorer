    "design": [
      {
        "id": "design1",
        "description": "The basilica was a three‑nave building (≈36 × 21 m) with an western apse and an eastern narthex, featuring eight Corinthian columns separating the central nave from the side aisles.",
        "sourceIds": ["wikipedia"]
      },
      {
        "id": "design2",
        "description": "The central nave contained a schola cantorum with an ambon, and the apse altar likely held relics visible through a confession window.",
        "sourceIds": ["wikipedia"]
      },
      {
        "id": "design3",
        "description": "A mausoleum from pre‑Christian times existed beneath the schola cantorum and was used as a funerary chamber in the 5th century.",
        "sourceIds": ["wikipedia"]
      },
      {
        "id": "design4",
        "description": "Some columns and the portico of the narthex were reused from nearby ancient villas.",
        "sourceIds": ["wikipedia"]
