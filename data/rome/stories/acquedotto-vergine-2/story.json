    "design": [
      {
        "id": "design1",
        "description": "The aqueduct ran mostly underground, with a final 1.8 km stretch on arches in the Campus Martius.",
        "sourceIds": [
          "wikipedia"
        ]
      },
      {
        "id": "design2",
        "description": "Channels were 50 cm to 1 m below ground, constructed using cut‑and‑cover, lined with cement, and roofed with vaults.",
        "sourceIds": [
          "wikipedia"
        ]
      },
      {
        "id": "design3",
        "description": "Materials included masonry, lead pipes, and terracotta, chosen for durability and ease of construction.",
        "sourceIds": [
          "wikipedia"
        ]
      },
      {
        "id": "design4",
        "description": "A shallow gradient of only 4 m over 20.5 km ensured gravity‑driven flow with minimal pressure.",
        "sourceIds": [
