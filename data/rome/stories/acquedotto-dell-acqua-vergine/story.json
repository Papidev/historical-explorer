    "design": [
      {
        "id": "design1",
        "description": "The aqueduct was built as a gravity system with a shallow downward gradient, using underground channels of masonry, lead, and terracotta, and a few arches for the final 1.8 km.",
        "sourceIds": ["wikipedia"]
      },
      {
        "id": "design2",
        "description": "Construction employed a cut‑and‑cover technique, lining channels with cement to prevent leaks and provide a smooth surface.",
